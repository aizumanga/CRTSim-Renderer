    "license": "CC0-1.0",
    "notes": [
        "Video needs FFmpeg and ffprobe, which CRTSim Renderer finds where Scoop installs them:",
        "    scoop install ffmpeg"
    ],
    "suggest": {
        "FFmpeg": "main/ffmpeg"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/aizumanga/CRTSim-Renderer/releases/download/v1.6.0/CRTSim-Renderer-v1.6.0-windows-x86_64.zip",
            "hash": "490ad84d101382c95e93bdc81390e25459370f9e9b0921a3c9c9e55c9a3ac2f0"
        }
    },
    "bin": "crtsim.exe",
    "shortcuts": [
        [
            "crtsim-desktop.exe",
            "CRTSim Renderer"
        ]
    ],
    "checkver": {
        "github": "https://github.com/aizumanga/CRTSim-Renderer"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/aizumanga/CRTSim-Renderer/releases/download/v$version/CRTSim-Renderer-v$version-windows-x86_64.zip",
