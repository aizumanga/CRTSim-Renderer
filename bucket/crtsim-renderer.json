    "suggest": {
        "FFmpeg": "main/ffmpeg"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/aizumanga/CRTSim-Renderer/releases/download/v1.7.0/CRTSim-Renderer-v1.7.0-windows-x86_64.zip",
            "hash": "55c3050acf326953b672cf24dd11f003f79914fee965905b7b9caa968fc23bc6"
        }
    },
    "bin": "crtsim.exe",
    "shortcuts": [
        [
            "crtsim-desktop.exe",
            "CRTSim Renderer"
        ]
    ],
    "checkver": {
        "github": "https://github.com/aizumanga/CRTSim-Renderer"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/aizumanga/CRTSim-Renderer/releases/download/v$version/CRTSim-Renderer-v$version-windows-x86_64.zip",
